# Server
PORT=8000

# Comma-separated browser origins. Add the URL of every frontend that should
# be allowed to call this backend, with no trailing slash.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Optional default Gemini key (a frontend can instead submit LLM settings to
# the API, depending on your deployment model).
GOOGLE_API_KEY=

# Cloudinary template storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Protect saved LLM API keys at rest. Generate a Fernet-compatible key.
LLM_SETTINGS_ENCRYPTION_KEY=
